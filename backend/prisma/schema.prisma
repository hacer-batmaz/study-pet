datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int             @id @default(autoincrement())
  username     String          @unique
  email        String          @unique
  passwordHash String
  coins        Int             @default(50)
  role         String          @default("USER") // "USER", "ADMIN"
  isActive     Boolean         @default(true)   // Hesap askıya alma kontrolü
  createdAt    DateTime        @default(now())
  pet          Pet?
  sessions     StudySession[]
  inventory    UserInventory[]
  adminLogs    AdminLog[]      @relation("AdminActionLogs")
}

model Pet {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        String   // 'cat', 'dog', 'rabbit'
  hungerLevel Int      @default(100) // 0-100 arası
  xp          Int      @default(0)
  level       Int      @default(1)
}

model StudySession {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        String   // 'Web Programlama', 'Matematik' vb.
  durationMinutes Int
  isCompleted     Boolean  @default(false)
  status          String   @default("in_progress") // 'in_progress', 'completed', 'abandoned'
  createdAt       DateTime @default(now())
}

model ShopItem {
  id          Int             @id @default(autoincrement())
  name        String
  type        String          // 'food', 'accessory', 'decor'
  price       Int
  effectValue Int             // yiyecekse açlığı artırma değeri
  spriteUrl   String
  isActive    Boolean         @default(true) // Admin panelinden pasife alma / soft-delete
  inventories UserInventory[]
}

model UserInventory {
  id         Int      @id @default(autoincrement())
  userId     Int
  itemId     Int
  quantity   Int      @default(1)
  isEquipped Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model AdminLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  action    String   // 'USER_SUSPEND', 'USER_ACTIVATE', 'ROLE_CHANGE', 'ITEM_CREATE', 'ITEM_TOGGLE'
  target    String   // İşlem yapılan hedef bilgi (Örn: 'User #2 (ahmet)')
  details   String?  // Ekstra bilgi
  createdAt DateTime @default(now())
  admin     User     @relation("AdminActionLogs", fields: [adminId], references: [id], onDelete: Cascade)
}